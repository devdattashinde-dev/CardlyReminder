<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/llContainer"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/_8sdp"
    android:layout_marginTop="@dimen/_8sdp"
    android:orientation="horizontal"
    android:paddingHorizontal="@dimen/_8sdp"
    android:paddingVertical="@dimen/_4sdp"
    android:background="@drawable/radio_button_background">
    <!-- Check icon to indicate selection (initially hidden) -->
    <ImageView
        android:id="@+id/ivCheck"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center_vertical"
        android:visibility="visible"
        android:src="@drawable/ic_unchecked_circle" />
    <!-- Text displaying the pricing option details -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_weight="1"
        android:layout_marginHorizontal="@dimen/_8sdp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvPlangLabel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Plan Option"
                android:layout_weight="1"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_14sdp"

                />
            <TextView
                android:id="@+id/tvMostPopuler"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Most Popular"
                android:background="@drawable/rounde_corner_bg_4dp"
                android:backgroundTint="@color/primary"
                android:textColor="@color/black"
                android:paddingHorizontal="@dimen/_4sdp"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/tvPricing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="$6.99"
                android:textStyle="bold"
                android:textColor="@android:color/white"
                android:textSize="@dimen/_18sdp"

                />

            <TextView
                android:id="@+id/tvPlanDuration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="For 1 Year"
                android:layout_marginStart="@dimen/_8sdp"
                android:textColor="@android:color/white"

                android:textSize="14sp"

                />
        </LinearLayout>

    </LinearLayout>


</LinearLayout>