<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:background="@color/black"
    android:orientation="vertical"
    android:gravity="center_horizontal">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/appBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/header_gradient"
        >

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/_38sdp">

            <ImageView
                android:id="@+id/icBack"
                android:layout_width="@dimen/_40sdp"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_back"
                android:padding="@dimen/_6sdp"
                app:tint="@color/primary"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/subscription"
                android:textColor="@color/white"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />
        </androidx.constraintlayout.widget.ConstraintLayout>
    </com.google.android.material.appbar.AppBarLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Subscription Details"
        android:textColor="@color/primary"
        android:textSize="@dimen/_14sdp"
        android:layout_marginTop="@dimen/_20sdp"
        />



    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginHorizontal="@dimen/_8sdp"
        android:layout_marginTop="@dimen/_20sdp"
        android:background="@drawable/rounde_corner_bg"
        android:backgroundTint="@color/gray2"
        android:padding="@dimen/_8sdp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:visibility="visible"
            android:layout_marginTop="@dimen/_16sdp"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/plan"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_weight="1"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/amount"
                android:textAlignment="textEnd"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_weight="1"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="visible"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvPlanName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="EasyGo"
                />

            <TextView
                android:id="@+id/tvAmount"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_11sdp"
                android:textAlignment="textEnd"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:text="$1"
                android:layout_marginTop="@dimen/_4sdp"
                />
        </LinearLayout>


        <TextView
            android:id="@+id/tvSubIdLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/subscription_id"
            android:textSize="@dimen/_12sdp"
            android:visibility="gone"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/_16sdp"
            />

        <LinearLayout
            android:id="@+id/linLaySubDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/_16sdp"
            >
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/subscription_start_date"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_weight="1"
                />
            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/subscription_end_date"
                android:textAlignment="textEnd"
                android:textSize="@dimen/_12sdp"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:layout_weight="1"
                />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/linLaySubDateValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/tvSubStartDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:layout_weight="1"
                android:layout_marginTop="@dimen/_4sdp"
                android:text="02-03-2025"
                />

            <TextView
                android:id="@+id/tvSubEndDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:textSize="@dimen/_11sdp"
                android:textColor="@color/white"
                android:textAlignment="textEnd"
                android:layout_weight="1"
                android:text="01-04-2025"
                android:layout_marginTop="@dimen/_4sdp"
                />
        </LinearLayout>



        <TextView
            android:id="@+id/tvCancelSubscription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/rounde_corner_border"
            android:backgroundTint="@color/red_dark"
            android:foregroundTint="@color/red_dark"
            android:text="Cancel Subscription"
            android:padding="@dimen/_8sdp"
            android:visibility="gone"
            android:textColor="@color/white"
            android:gravity="center"
            android:layout_marginTop="@dimen/_16sdp"
            />

        <TextView
            android:id="@+id/tvCancelSubscriptionLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You've canceled your subscription"
            android:textColor="@color/red_dark"
            android:layout_marginTop="@dimen/_16sdp"
            />
        <TextView
            android:id="@+id/tvSubscriptionEndOn"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="You've canceled your subscription"
            android:textSize="@dimen/_12sdp"
            android:textColor="@color/white"
            />
    </LinearLayout>

</LinearLayout>
