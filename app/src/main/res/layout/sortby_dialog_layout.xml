<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/rounde_corner_bg"
    android:backgroundTint="@color/gray2"
    android:orientation="vertical"
    android:padding="@dimen/_8sdp"
    android:layout_weight="1"
    >
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/sort_by"
        android:textStyle="bold"
        android:textSize="@dimen/_12sdp"
        android:textColor="@color/white"
        android:layout_gravity="center_horizontal"
        />
    <LinearLayout
        android:id="@+id/sortByClosingDateAsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_upward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/statement_closing_date"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortByClosingDateDsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_downward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/statement_closing_date"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/sortByDueDateAsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_upward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_due_date"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortByDueDateDsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_downward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payment_due_date"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortByValidThruAsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_upward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/valid_thru"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortByValidThruDsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_downward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/valid_thru"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortByCreatedTimeAsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_upward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/created_time"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/sortByCreatedTimeDsc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="@dimen/_4sdp"
        android:background="@drawable/rounde_corner_bg_4dp"
        android:backgroundTint="@color/gray"
        android:layout_marginTop="@dimen/_8sdp"
        android:layout_marginBottom="@dimen/_16sdp"
        >
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@drawable/baseline_arrow_downward_24"
            android:background="@drawable/rounde_corner_bg_4dp"
            android:backgroundTint="@color/gray2"
            />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/created_time"
            android:textColor="@color/white"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="@dimen/_8sdp"
            />
    </LinearLayout>
</LinearLayout>